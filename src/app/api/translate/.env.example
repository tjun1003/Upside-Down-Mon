# ═══════════════════════════════════════════════════════════════════
# 🔐 Environment Variables
# ═══════════════════════════════════════════════════════════════════

# Translation performance
# 0 = disable KB/RAG startup to reduce load time and memory usage
USE_KB=0

# Local Sailor2 generation cap. Smaller = faster.
MAX_TRANSLATION_TOKENS=96

# Simulated streaming delay between chunks in seconds
STREAM_CHUNK_DELAY=0.01

# Translation cache size for repeated requests
TRANSLATION_CACHE_SIZE=128

# MongoDB Atlas connection (optional)
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=sea_translate

# Quantization mode:
# dynamic = CPU dynamic int8 quantization
# 8bit = GPU bitsandbytes int8 when available, CPU falls back to dynamic int8
# 4bit = GPU bitsandbytes 4bit when available
# none = no quantization
MODEL_QUANTIZATION=dynamic

# 1 = use Sailor2-8B when GPU is available, otherwise use 1B
USE_LARGE_MODEL=0

# HuggingFace Token (获取: https://huggingface.co/settings/tokens)
HF_TOKEN=your_huggingface_token_here

# Telegram Bot Token (可选, 从 @BotFather 获取)
# TELEGRAM_BOT_TOKEN=

# WhatsApp (可选)
# WHATSAPP_TOKEN=
# WHATSAPP_VERIFY_TOKEN=sea_translate_token
# WHATSAPP_PHONE_NUMBER_ID=
