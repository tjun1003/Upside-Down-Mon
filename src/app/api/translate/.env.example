# 🔐 Environment Variables Configuration
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values
# ═══════════════════════════════════════════════════════════════════

# Translation performance
# 0 = disable KB/RAG startup to reduce load time and memory usage
USE_KB=0

# Frontend stream proxy target
TRANSLATION_API_URL=http://127.0.0.1:8000

# MongoDB Atlas KB (RAG)
# 1 = enable MongoDB Atlas retrieval for assistant context
USE_ATLAS_KB=1
