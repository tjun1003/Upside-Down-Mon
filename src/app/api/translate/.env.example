>>>>>>> e419237312db089987bcb98f9dd4857969e66471
MONGODB_ATLAS_DB=<database_name>
MONGODB_ATLAS_COLLECTION=<collection_name>

# Collection field mapping
MONGODB_TEXT_FIELD=text
MONGODB_SOURCE_FIELD=source
MONGODB_METADATA_FIELD=metadata
MONGODB_EMBEDDING_FIELD=embedding

# Atlas Vector Search settings
MONGODB_USE_VECTOR_SEARCH=1
MONGODB_ATLAS_VECTOR_INDEX=default
MONGODB_RAG_TOP_K=3
MONGODB_RAG_NUM_CANDIDATES=60
RAG_CONTEXT_MIN_SCORE=0.55
INTERNAL_RAG_ENABLED=1

# External web fallback RAG (free DuckDuckGo)
EXTERNAL_RAG_ENABLED=1
EXTERNAL_RAG_PROVIDER=duckduckgo_html
EXTERNAL_RAG_SEARCH_URL=https://html.duckduckgo.com/html/
EXTERNAL_RAG_ALLOWED_DOMAINS=
EXTERNAL_RAG_QUERY_SUFFIX=Malaysia
EXTERNAL_RAG_MAX_RESULTS=3
EXTERNAL_RAG_SEARCH_TIMEOUT_SEC=4.0
EXTERNAL_RAG_FETCH_PAGE_CONTENT=1
EXTERNAL_RAG_PAGE_FETCH_TIMEOUT_SEC=4.0
EXTERNAL_RAG_PAGE_MAX_CHARS=8000

# Local Sailor2 generation caps.
# Set hard caps to 0 and rely on higher soft caps to avoid truncation.
MAX_TRANSLATION_TOKENS=0
ASSISTANT_MAX_NEW_TOKENS=0
SOFT_MAX_TRANSLATION_TOKENS=4096
SOFT_MAX_ASSISTANT_TOKENS=6144
ASSISTANT_MAX_REPLY_CHARS=2400

# Simulated streaming delay between chunks in seconds
STREAM_CHUNK_DELAY=0.01

# Translation cache size for repeated requests
TRANSLATION_CACHE_SIZE=128

# Model loading behavior
LAZY_LOAD_MODEL=1
STARTUP_CHECK_CACHE=0
UVICORN_RELOAD=0

# Assistant rule path switch: minimal | full | off
ASSISTANT_RULE_MODE=off

# Quantization mode:
# dynamic = CPU dynamic int8 quantization
# 8bit = GPU bitsandbytes int8 when available, CPU falls back to dynamic int8
# 4bit = GPU bitsandbytes 4bit when available
# none = no quantization
MODEL_QUANTIZATION=dynamic

# 1 = use Sailor2-8B when GPU is available, otherwise use 1B
USE_LARGE_MODEL=0
TRANSFORMERS_VERBOSITY=info

# HuggingFace Token (获取: https://huggingface.co/settings/tokens)
HF_TOKEN=<your_huggingface_token>

# Telegram Bot Token (可选, 从 @BotFather 获取)
# TELEGRAM_TOKEN=

# WhatsApp (可选)
# WHATSAPP_TOKEN=
# WHATSAPP_VERIFY_TOKEN=sea_translate_token
# WHATSAPP_PHONE_ID=
# WHATSAPP_PHONE_NUMBER_ID=

# PDF Processing Configuration
PDF_DEFAULT_CHUNK_SIZE=1000          # 每个chunk的默认字符数
PDF_DEFAULT_CHUNK_OVERLAP=200        # chunk之间的重叠字符数
PDF_MIN_CHUNK_SIZE=100               # 最小chunk大小
PDF_MAX_FILE_SIZE_MB=10              # PDF文件最大尺寸（MB）

